# ==========================================
# Database & Core Settings
# ==========================================
DATABASE_URL=sqlite:///job_agent.db
DRY_RUN=true
MATCH_THRESHOLD=0.70
DAILY_SEND_CAP=25

# ==========================================
# Input Files
# ==========================================
JOBS_FILE=jobs_input.json
RESUME_FILE=resume.txt

# ==========================================
# AI Models (Provide at least one)
# ==========================================
# Google Gemini API key (from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Groq API key (from https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.1-8b-instant

# ==========================================
# Gmail Integration (OAuth2)
# ==========================================
# Generated via `python auth_gmail.py client_secret.json`
GMAIL_TOKEN_JSON=
GMAIL_INBOX_SYNC=true
GMAIL_INBOX_QUERY=in:inbox newer_than:14d -from:me
REPLY_BATCH_LIMIT=50
INBOX_SYNC_LIMIT=50

# ==========================================
# Web Scraping & Remote Fetching
# ==========================================
ENABLE_REMOTE_FETCH=true
MAX_JOBS_PER_SOURCE=20

# ==========================================
# Job Aggregator APIs (Optional / Free tiers)
# ==========================================
# Jooble — https://jooble.org/api/about
JOOBLE_API_KEY=your_jooble_api_key_here

# Adzuna — https://developer.adzuna.com
ADZUNA_APP_ID=your_adzuna_app_id_here
ADZUNA_APP_KEY=your_adzuna_app_key_here

# ==========================================
# Recruiter Discovery (Hunter.io - Optional)
# ==========================================
HUNTER_API_KEY=your_hunter_api_key_here
HUNTER_MIN_SCORE=0.85

# LinkedIn session cookie (optional for Scout)
LINKEDIN_LI_AT=your_linkedin_li_at_cookie_here

# ==========================================
# Applicant Info (for Auto-Apply)
# ==========================================
APPLICANT_FIRST_NAME=Firstname
APPLICANT_LAST_NAME=Lastname
APPLICANT_EMAIL=user@example.com
APPLICANT_PHONE=
APPLICANT_LINKEDIN_URL=https://linkedin.com/in/username
APPLICANT_YEARS_EXP=0
RESUME_PDF_PATH=/path/to/your/resume.pdf
AUTO_APPLY_DAILY_CAP=10
